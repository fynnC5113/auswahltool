# Copy to .env.local and fill in. Never commit real values.
# Local development and tests use the Supabase project "auswahltool-test".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mail module, transport "gmail": a separate Gmail account for the tool,
# 2-step verification on, 16-character app password (not the account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Reply-To address (function mailbox of the Law Clinic); rounds.reply_to overrides it.
MAIL_REPLY_TO=

# Mail module, transport "graph" (from the IT): app registration in Entra ID,
# Mail.Send scoped to the function mailbox via RBAC for Applications.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Function mailbox the app sends from, e.g. termin.lawclinic@law-school.de
GRAPH_MAILBOX=

# Base URL for links in mails (login, applicant pages). Locally
# http://localhost:3000, on Vercel https://auswahltool.vercel.app
APP_URL=
