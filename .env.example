# Copy to .env.local and fill in. Never commit real values.
# Local development and tests use the Supabase project "auswahltool-test".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mail module, transport "gmail": a separate Gmail account for the tool,
# 2-step verification on, 16-character app password (not the account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Reply-To address (function mailbox of the Law Clinic); rounds.reply_to overrides it.
MAIL_REPLY_TO=
